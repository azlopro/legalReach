# Server Configuration
LEGAL_REACH__SERVER__HOST=127.0.0.1
LEGAL_REACH__SERVER__PORT=3000
LEGAL_REACH__SERVER__CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
LEGAL_REACH__SERVER__MAX_REQUEST_SIZE=10485760

# Database Configuration
LEGAL_REACH__DATABASE__HOST=localhost
LEGAL_REACH__DATABASE__PORT=5432
LEGAL_REACH__DATABASE__USERNAME=lead_manager_user
LEGAL_REACH__DATABASE__PASSWORD=lead_manager_password
LEGAL_REACH__DATABASE__DATABASE_NAME=lead_management
LEGAL_REACH__DATABASE__MAX_CONNECTIONS=10

# Authentication
LEGAL_REACH__AUTH__API_KEY=your-secure-api-key-change-this-in-production
LEGAL_REACH__AUTH__SESSION_TIMEOUT_HOURS=24

# Email Configuration
LEGAL_REACH__EMAIL__SMTP_HOST=smtp.gmail.com
LEGAL_REACH__EMAIL__SMTP_PORT=587
LEGAL_REACH__EMAIL__SMTP_USERNAME=your-email@gmail.com
LEGAL_REACH__EMAIL__SMTP_PASSWORD=your-app-password
LEGAL_REACH__EMAIL__FROM_EMAIL=your-email@gmail.com
LEGAL_REACH__EMAIL__FROM_NAME="Lead Management System"
LEGAL_REACH__EMAIL__MOCK_MODE=true

# Feature Flags
LEGAL_REACH__FEATURES__ENABLE_EMAIL_SENDING=true
LEGAL_REACH__FEATURES__MAX_LEADS_PER_IMPORT=1000
LEGAL_REACH__FEATURES__MAX_LEADS_PER_EXPORT=10000
LEGAL_REACH__FEATURES__ENABLE_RATE_LIMITING=true

# Logging
RUST_LOG=legal_reach=info,tower_http=info

# Runtime Mode
RUN_MODE=development