# .env
QUICKEMAILVERIFICATION_API_KEY=2e2f04228516817e44773b45fe0ce23bdaa7707814f71d78da649e312ff8
ABUSEIPDB_API_KEY=d1534b2e204690350ca92c4269f8bcf3a08a5fb5a4087dc8a5a8189a6c63170464ac49d3130e0ef0

# --- PostgreSQL Configuration ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=leads_db

# --- Backend Configuration ---
# Set DB_TYPE to 'postgres' to use PostgreSQL or 'sqlite' for SQLite
DB_TYPE=postgres

# PostgreSQL connection details (uses service name 'db' from docker-compose)
DB_HOST=db
DB_PORT=5432
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}
DB_SSLMODE=disable

# SQLite path (used if DB_TYPE=sqlite)
DB_PATH=leads.db

# Server configuration
SERVER_PORT=3000
GIN_MODE=release # Use 'debug' for development, 'release' for production
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080 # Allow frontend to connect

# Security
API_KEY=a-very-secret-api-key-change-me

# SMTP Configuration for sending emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=super-secret-password
ZAPIER_EMAIL=your-zapier-webhook@robot.zapier.com

# --- Frontend Configuration ---
FRONTEND_PORT=8080
